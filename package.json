{
  "name": "@zseven-w/dsh-computer",
  "version": "0.1.0-rc.1",
  "description": "A headless-first macOS Computer Use driver for DeepSeek Harness with AX-first observations, window-bound multimodal evidence, host-owned approval, and evidence-backed action receipts",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZSeven-W/dsh-computer.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "accessibility",
    "macos",
    "automation",
    "agent"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "native/Package.swift",
    "native/Sources",
    "native/Tests",
    "scripts/install-local-helper.mjs",
    "scripts/release",
    "RELEASE.md",
    "cordis.patch.yml",
    "README.md",
    "README.*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:node": "tsc -p tsconfig.json && node scripts/run-tests.mjs",
    "test:swift": "node scripts/test-swift.mjs",
    "test:native-protocol": "node scripts/native-protocol-smoke.mjs",
    "test:scroll": "node scripts/scroll-integration.mjs",
    "test:approval": "node scripts/approval-integration.mjs",
    "helper:install-local": "node scripts/install-local-helper.mjs",
    "test": "npm run test:node && npm run test:swift && npm run test:native-protocol",
    "prepack": "npm run build && npm test",
    "prepublishOnly": "npm run smoke:pack",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "release": "node scripts/release/release.mjs",
    "release:dry-run": "node scripts/release/release.mjs --dry-run",
    "release:verify": "node scripts/release/verify-artifact.mjs",
    "release:checksum": "node scripts/release/checksum.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      "env-read",
      "global-hook",
      "subprocess",
      "tool-registration"
    ]
  },
  "dshHostRuntime": {
    "services": [
      "tools",
      "approval",
      "attachments",
      "llm"
    ],
    "note": "Only tools is a hard activation dependency. Approval, attachments, and llm are resolved structurally and lazily for risky actions and visual observation; all host services are intentionally absent from dependencies and peerDependencies."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
