# DSH Computer release configuration template.
#
# Copy this file to scripts/release/release-config.env and fill in the values.
# The .env file is git-ignored. Real environment variables with the same names
# always take precedence over this file.
#
# The signing identity and notary credentials are never hardcoded in the repo
# and must never be committed.

# Developer ID Application certificate common name or SHA-1, exactly as shown
# by: security find-identity -v -p codesigning
# Example: "Developer ID Application: Your Name (TEAM123456)"
# This is the only value required to move past the signing step.
DSH_COMPUTER_SIGNING_IDENTITY=

# Optional. If set, the pipeline verifies the signed app's TeamIdentifier
# matches this value before continuing. Find it in Apple Developer membership.
DSH_COMPUTER_TEAM_ID=

# App Store Connect API key for notarytool. Create a Team Key with Developer ID
# capability at https://appstoreconnect.apple.com/access/api
DSH_COMPUTER_NOTARY_KEY_ID=
DSH_COMPUTER_NOTARY_ISSUER_ID=
DSH_COMPUTER_NOTARY_KEY_PATH=
